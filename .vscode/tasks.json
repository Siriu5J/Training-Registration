{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "phpunit:unit",
            "type": "shell",
            "command": "php vendor/bin/phpunit --configuration phpunit.xml",
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "phpunit:integration",
            "type": "shell",
            "command": "php vendor/bin/phpunit --configuration phpunit-integration.xml",
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "phpunit:all",
            "dependsOn": [
                "phpunit:unit",
                "phpunit:integration"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}